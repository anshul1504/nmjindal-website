 # Copy to .env on the server and fill in. Never commit the real .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=nmjindalglobal.com,www.nmjindalglobal.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nmjindalglobal.com,https://www.nmjindalglobal.com
# Set to 1 once the site works over HTTPS (secure cookies + HSTS)
DJANGO_HTTPS=1

